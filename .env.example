# User Configuration
PUID=1000
PGID=1000
TZ=America/New_York

# Directory Configuration
# These are the base directories where your configuration and data will be stored
CONFIG_DIR=/home/user/apps
DATA_DIR=/home/user/data

# Homarr Configuration
# Generate a 64-character hex string using: openssl rand -hex 32
# REQUIRED for Homarr to function properly
SECRET_ENCRYPTION_KEY=your_64_character_hex_string_here

# Cloudflare Configuration
# Get this token from your Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here

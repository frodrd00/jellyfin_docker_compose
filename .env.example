# User Configuration
PUID=1000
PGID=1000
TZ=America/New_York

# Directory Configuration
# These are the base directories where your configuration and data will be stored
CONFIG_DIR=/home/user/apps
DATA_DIR=/home/user/data

# Cloudflare Configuration
# Get this token from your Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TOKEN=your_cloudflare_tunnel_token_here
